---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Page not found — ${site.name}`} description="This page doesn't exist." path="/404">
  <SiteNav />
  <main id="main">
    <section class="section container not-found">
      <p class="section-eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <a class="button button--primary" href="/">Back to home</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
</style>
