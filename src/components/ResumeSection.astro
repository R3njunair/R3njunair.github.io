---
import SectionHeading from './SectionHeading.astro';
---

<section id="resume" class="section resume">
  <div class="container resume__inner">
    <SectionHeading
      eyebrow="Résumé"
      title="Full résumé, one click away"
      lede="A print-friendly version and a downloadable PDF, generated from the same content as this page -- always in sync."
    />
    <div class="button-row">
      <a class="button button--primary" href="/resume.pdf" download>Download PDF</a>
      <a class="button button--secondary" href="/resume">View print-friendly page</a>
    </div>
  </div>
</section>
