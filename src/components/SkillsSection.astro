---
import SectionHeading from './SectionHeading.astro';
import { skillGroups } from '../data/skills';
import { certifications, education } from '../data/certifications';
---

<section id="skills" class="section skills">
  <div class="container">
    <SectionHeading eyebrow="Skills" title="Grouped by where they're used" />

    <div class="grid grid--3">
      {skillGroups.map((group) => (
        <div class="card skill-group">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="grid grid--2 credentials">
      <div>
        <h3>Certifications</h3>
        <ul class="plain-list">
          {certifications.map((cert) => (
            <li>{cert.name}{cert.issuer ? ` — ${cert.issuer}` : ''}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Education</h3>
        <p>
          {education.credential}<br />
          {education.institution} · {education.year}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .skill-group h3 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .skill-group ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .skill-group li {
    margin-bottom: 0.4rem;
  }

  .credentials {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .credentials h3 {
    font-size: 1.05rem;
    margin: 0 0 0.75rem;
  }

  .plain-list {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .plain-list li {
    margin-bottom: 0.5rem;
  }
</style>
